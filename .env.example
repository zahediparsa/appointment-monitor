# MONITOR_POLL_INTERVAL_MIN=15
# MONITOR_BACKOFF_START_MIN=5
# MONITOR_BACKOFF_MAX_MIN=60
# MONITOR_MAX_FAILURES=5
# MONITOR_CONFIRMATIONS=2
